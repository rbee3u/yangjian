{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjian.local/schemas/contract.schema.json",
  "title": "Contract",
  "type": "object",
  "required": ["schema_version", "id", "chain_id", "address", "versions", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^[0-9]+:0x[0-9a-fA-F]{40}$"},
    "chain_id": {"type": "integer", "minimum": 1},
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "labels": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
