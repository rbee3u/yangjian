{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjian.local/schemas/contract_version.schema.json",
  "title": "ContractVersion",
  "type": "object",
  "required": ["schema_version", "id", "contract_id", "valid_from_block", "valid_from_source", "runtime_bytecode_hash", "proxy_type", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "valid_from_block": {"type": "integer", "minimum": 1},
    "valid_from_source": {"enum": ["observed", "estimated", "deployment"]},
    "valid_to_block": {"type": ["integer", "null"], "minimum": 1},
    "runtime_bytecode_hash": {"type": "string", "minLength": 1},
    "proxy_type": {"enum": ["unknown", "none", "EIP-1967", "EIP-1822", "EIP-1167", "beacon", "other"]},
    "implementation_address": {"type": ["string", "null"]},
    "source_revision_id": {"type": ["string", "null"]},
    "abi_hash": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
